# Connection settings for the project scripts. Usage:
#   cp config.example.env .env      # .env is ignored by git
#   (edit .env)
#   source .env                     # in the shell that runs the scripts
# Every variable is exported so Python and psql inherit it.
# Never put a password here: use ~/.pgpass or your own environment.

# Option A - local psql (libpq reads the PG* variables)
export CCU_PSQL="psql"
export PGHOST=localhost
export PGPORT=5432
export PGUSER=your_user

# Option B - psql inside a Docker PostgreSQL container (no local client
# needed). Comment out Option A and uncomment this line:
# export CCU_PSQL="docker exec -i your_container psql -U your_user"

# Database used to create/drop the project databases
export CCU_ADMIN_DB=postgres
# Dedicated databases: <prefix>_small, <prefix>_portfolio,
# <prefix>_test and <prefix>_test_partial_hours
export CCU_DB_PREFIX=cloud_cost_utilization
